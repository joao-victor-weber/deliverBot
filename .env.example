# ---- Provedor de WhatsApp: TESTE (padrão) | WAHA | META ----
# TESTE -> mensagens só aparecem no console, não precisa configurar nada abaixo.
# WAHA  -> WhatsApp real via Docker + QR Code (recomendado para testar rápido).
# META  -> WhatsApp Business Cloud API oficial (precisa de app na Meta).
WHATSAPP_PROVIDER=TESTE

# ---- WAHA (WhatsApp HTTP API) ----
# Suba com: docker compose up  (veja docker-compose.yml)
WAHA_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=

# ---- WhatsApp Business Cloud API (Meta) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Palavra secreta escolhida por você, usada na verificação do webhook na Meta
WHATSAPP_VERIFY_TOKEN=trocar_por_uma_palavra_secreta

# ---- URL pública onde o app está rodando (usada para montar o link único /m/<token>) ----
# Em desenvolvimento local com ngrok: https://xxxx.ngrok-free.app
BASE_URL=http://localhost:5000

# ---- Restaurante ----
NOME_RESTAURANTE=Barbaros Lanches
TELEFONE_RESTAURANTE=(47) 3000-0000
ENDERECO_RESTAURANTE=Rua das Hamburguerias, 123 - Centro
HORARIO_FUNCIONAMENTO=Terça a Domingo, das 18h às 23h30
TAXA_ENTREGA=6.00
CEP_RESTAURANTE=89460-000
RAIO_ENTREGA_KM=6

# ---- Banco de dados ----
# Caminho do arquivo SQLite (criado automaticamente)
DATABASE_PATH=data/deliverybot.db

# ---- Tempo estimado de preparo (minutos), usado na mensagem de confirmação ----
TEMPO_PREPARO_MIN=40

# ---- Validade do link único de pedido, em minutos ----
VALIDADE_LINK_MIN=30

# Cidades atendidas pelo restaurante, separadas por virgula
CIDADES_ATENDIDAS=Uniao da Vitoria
